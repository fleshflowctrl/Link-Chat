# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postmark (transactional email — signup confirm, password reset)
# Server token: Postmark → Servers → API tokens
POSTMARK_SERVER_TOKEN=
# Signup: no e-mail verification (instant login).
# Postmark: unread-message reminders (cron /api/cron/chat-unread-email).
# CHAT_UNREAD_EMAIL_DELAY_MS=300000
# Verified sender (must match a confirmed sender in Postmark)
POSTMARK_FROM_EMAIL=info@discreetnetwerk.nl
# Optional inbox display name (default: DiscreetNetwerk.nl)
# POSTMARK_FROM_NAME=DiscreetNetwerk.nl
# Optional: default is "outbound"
# POSTMARK_MESSAGE_STREAM=outbound

# Stripe (credit purchases + Pro subscription)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pro monthly price from Stripe Dashboard (use live price_... in production)
STRIPE_PRO_PRICE_ID=price_1TZTydRoFAYFDiXDHhGIjFov
# Optional: STRIPE_PRO_PRODUCT_ID=prod_UYbAEhUzc8kZoq
# Public site URL for Stripe redirects (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Manual operator + Telegram (optional — reply from phone)
# MANUAL_OPERATOR_MODE=1
# TELEGRAM_BOT_TOKEN=          # from @BotFather
# TELEGRAM_OPERATOR_CHAT_IDS=  # your chat id (send /start to bot to see it); also used for new signup alerts (🎉🎉🎉)
# TELEGRAM_OPERATOR_GROUP_CHAT_ID=  # supergroup with Topics: one topic per gesprek (recommended)
# TELEGRAM_WEBHOOK_SECRET=     # random string; sent as X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_OPERATOR_USER_ID=   # optional Supabase auth user uuid for assigned_operator_id

# Vercel: add STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, NEXT_PUBLIC_APP_URL
# in Project → Settings → Environment Variables (Production + Preview).
# Webhook URL: https://YOUR-DOMAIN/api/webhooks/stripe
# Events: checkout.session.completed, invoice.paid, customer.subscription.updated, customer.subscription.deleted
