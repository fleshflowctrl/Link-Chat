# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (credit purchases)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public site URL for Stripe redirects (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel: add STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, NEXT_PUBLIC_APP_URL
# in Project → Settings → Environment Variables (Production + Preview).
# Webhook URL: https://YOUR-DOMAIN/api/webhooks/stripe
# Event: checkout.session.completed
