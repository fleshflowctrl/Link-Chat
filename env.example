# Copy to .env.local (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key (either name works; dashboard often labels it "anon public")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only: service_role key (bypasses RLS). Chat now uses the logged-in
# user's session + RLS — you do not need this for normal app usage.
# SUPABASE_SERVICE_ROLE_KEY=

XAI_API_KEY=

# Optional: defaults to grok-4.3
# XAI_CHAT_MODEL=grok-4.3

# Optional: xAI HTTP timeout in ms (default 120000). Lower on hosts with strict serverless limits.
# XAI_FETCH_TIMEOUT_MS=120000

# Optional: require this header (Authorization: Bearer <value>) for /api/grok-test in development
# GROK_SMOKE_TEST_SECRET=

# Optional: “Continue without signing in” — localhost + *.vercel.app work without vars;
# custom production domain needs one of:
# ALLOW_TEST_BYPASS=1
# NEXT_PUBLIC_ALLOW_TEST_BYPASS=true
