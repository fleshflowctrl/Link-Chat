# Copy to .env.local (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key (either name works; dashboard often labels it "anon public")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service_role key — REQUIRED on Vercel for bots to reply when the
# user is offline. Powers /api/cron/chat-pending-replies (runs every minute).
# Without it, async replies only deliver while the app is open.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: secures cron routes. Vercel sends Authorization: Bearer <value>
# automatically when set; x-vercel-cron is also accepted.
# CRON_SECRET=

XAI_API_KEY=

# Optional: defaults to grok-4.3
# XAI_CHAT_MODEL=grok-4.3

# Optional: sampling temperature 0–2 for chat (default 0.8 — alive,
# varied real-person rhythm). Drop to ~0.6 for more steady, predictable
# replies; bump to ~1.0 for wilder, more spontaneous personas.
# XAI_CHAT_TEMPERATURE=0.8

# Optional: xAI HTTP timeout in ms (default 120000). Lower on hosts with strict serverless limits.
# XAI_FETCH_TIMEOUT_MS=120000

# Optional: enable a second-pass "draft → editor → maybe rewrite" round per AI
# turn. Approximately doubles latency and cost; off by default. Useful for
# A/B tests or premium quality flows. Accepts: 1, true, yes, on.
# XAI_DRAFT_REVISE=0

# Optional: force a different timezone for the personas' "local clock" in chat.
# Defaults to Europe/Amsterdam since the app is NL-targeted. Override with any
# IANA timezone (e.g. Europe/Berlin, America/New_York) if you ship elsewhere.
# This matters because servers (Vercel) usually run in UTC, which would
# otherwise feed personas a clock that's 1–2 hours behind their real one.
# PERSONA_DEFAULT_TZ=Europe/Amsterdam

# --- Image generation (AI personas sending photos) ---
# Backend selection. Default = "hf-space" (mrfakename/Z-Image-Turbo on
# Hugging Face Spaces — free, but rate-limited and subject to cold-starts).
# Set to "stub" during local dev or in tests to silently drop photo
# directives. fal.ai / Replicate placeholders exist; wire them up when you
# move to a paid backend.
# IMAGE_BACKEND=hf-space

# Optional Hugging Face token. Anonymous calls work for public Spaces but
# get aggressively rate-limited; a token (HF Pro for ZeroGPU priority)
# stabilises generation in production.
# HF_TOKEN=

# Optional vision model override for Grok. When the user sends a photo,
# the chat call switches to this model so Grok can actually see the
# image. If unset, the default chat model is used (most grok-4.x models
# are multimodal as of late 2025).
# XAI_VISION_MODEL=grok-4-vision

# Optional kill-switch for human-like reply pacing. The AI peer schedules her
# replies with volume-first realistic timing — short intervals dominate so
# the user keeps texting; long pauses exist for realism but are rare:
#   * first 3 turns: 0.6–1.8s (engagement hook, always synchronous)
#   * "hot" mode (she replied <5min ago): ~80% within 60s, ~99% within 5min
#   * "warm" mode (5–30min ago): ~65% within 2min, ~96% within 15min
#   * "cold" mode (30min+ / first reply): ~55% within 4min, ~97% within 30min
#   * bedtime: random per persona per night in [01:45, 03:35]
#     (deterministic from persona id + calendar date, so consistent within a
#     single conversation but drifts night to night). Within the last hour
#     before bedtime, Grok writes a warm goodnight reply ("ik ga zo slapen,
#     spreken we morgen weer?"). After bedtime, replies are scheduled for the
#     morning between 07:30 and 09:00 (random per night).
# Delays >25s are queued in chat_pending_replies and delivered server-side via
# cron + background waitUntil (user does not need to stay in the app). Set to 1
# to bypass entirely and reply as fast as
# Grok responds — useful in load tests or automated demos. Accepts: 1, true,
# yes, on.
# XAI_DISABLE_PACING=0

# Optional: require this header (Authorization: Bearer <value>) for /api/grok-test in development
# GROK_SMOKE_TEST_SECRET=

# Optional: “Continue without signing in” — localhost + *.vercel.app work without vars;
# custom production domain needs one of:
# ALLOW_TEST_BYPASS=1
# NEXT_PUBLIC_ALLOW_TEST_BYPASS=true

# --- Stripe (credit purchases) — REQUIRED on Vercel for real payments ---
# Dashboard → Developers → API keys → Secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# Production: Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://YOUR-VERCEL-DOMAIN/api/webhooks/stripe
#   Event: checkout.session.completed
#   → Signing secret (whsec_...)
# Local dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Your public site URL (no trailing slash). On Vercel use Production URL, e.g.:
# NEXT_PUBLIC_APP_URL=https://link-chat-hj1c.vercel.app
NEXT_PUBLIC_APP_URL=

# Microsoft Clarity — session replay / heatmaps (id from clarity.microsoft.com → Setup)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# 911-for-me affiliate conversion postback (optional payout on signup CV)
# NEXT_PUBLIC_AFFILIATE_CV_PAYOUT=
