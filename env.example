# Copy to .env.local (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only: service_role key (bypasses RLS). Chat now uses the logged-in
# user's session + RLS — you do not need this for normal app usage.
# SUPABASE_SERVICE_ROLE_KEY=

XAI_API_KEY=

# Optional: defaults to grok-4.3
# XAI_CHAT_MODEL=grok-4.3

# Optional: require this header (Authorization: Bearer <value>) for /api/grok-test in development
# GROK_SMOKE_TEST_SECRET=
